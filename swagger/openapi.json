{
  "openapi": "3.0.3",
  "info": {
    "title": "Ticket Booking System API",
    "version": "1.0.0",
    "description": "API for event management, ticket booking, and users."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "responses": {
          "200": { "description": "New access token" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "Get all events",
        "responses": {
          "200": {
            "description": "List of events"
          }
        }
      },
      "post": {
        "summary": "Create event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "summary": "Get event by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Event" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update event",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Updated" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "summary": "Delete event",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/bookings": {
      "get": {
        "summary": "Get all bookings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of bookings" }
        }
      },
      "post": {
        "summary": "Create booking",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingInput"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/bookings/{id}": {
      "put": {
        "summary": "Update booking",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingInput"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "summary": "Delete booking",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get all users",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of users" }
        }
      },
      "post": {
        "summary": "Create user",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/users/{id}": {
      "put": {
        "summary": "Update user",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "summary": "Delete user",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" },
          "404": { "description": "Not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": ["username", "email", "phone", "password"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "password": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "admin", "organizer"] },
          "isBlocked": { "type": "boolean" }
        }
      },
      "EventInput": {
        "type": "object",
        "required": ["title", "description", "venue", "city", "eventDate", "price", "totalSeats", "availableSeats", "status"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "venue": { "type": "string" },
          "city": { "type": "string" },
          "eventDate": { "type": "string", "format": "date-time" },
          "price": { "type": "number" },
          "totalSeats": { "type": "integer" },
          "availableSeats": { "type": "integer" },
          "status": { "type": "string", "enum": ["draft", "published", "cancelled", "sold_out"] }
        }
      },
      "BookingInput": {
        "type": "object",
        "required": ["bookingId", "event", "user", "seatNumber", "ticketType", "bookingStatus", "paymentStatus", "priceAtBooking", "passengerName", "passengerPhone", "ticketQRCode"],
        "properties": {
          "bookingId": { "type": "string" },
          "event": { "type": "string" },
          "user": { "type": "string" },
          "seatNumber": { "type": "integer" },
          "ticketType": { "type": "string", "enum": ["standard", "vip", "student", "child"] },
          "bookingStatus": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "refunded"] },
          "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "failed", "refunded"] },
          "priceAtBooking": { "type": "number" },
          "currency": { "type": "string" },
          "passengerName": { "type": "string" },
          "passengerPhone": { "type": "string" },
          "ticketQRCode": { "type": "string" },
          "isUsed": { "type": "boolean" },
          "isForResale": { "type": "boolean" },
          "resalePrice": { "type": ["number", "null"] },
          "resaleStatus": { "type": "string", "enum": ["not_listed", "listed", "reserved", "sold"] },
          "canBeCancelled": { "type": "boolean" }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["username", "email", "phone", "passwordHash", "role", "isBlocked"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "passwordHash": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "admin", "organizer"] },
          "isBlocked": { "type": "boolean" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
